{
  "name": "wedding-lan-thanh",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Online wedding invitation for Hoang Lan & Tran Kim Thanh - 29.11.2026",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "sync:core": "bun scripts/sync-core.ts",
    "perf": "bun scripts/perf-page.ts",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "optimize": "bun scripts/optimize-images.ts",
    "optimize:art": "bun scripts/optimize-art.ts",
    "shots": "bun scripts/shots.ts",
    "check:motion": "bun scripts/check-motion.ts",
    "check:moi": "bun scripts/check-moi.ts",
    "check:envelope": "bun scripts/check-envelope.ts",
    "deploy": "bun run build && bunx wrangler pages deploy dist --project-name lanthanh --commit-dirty=true",
    "rsvp:list": "cd worker && bunx wrangler kv key list --binding RSVP",
    "rsvp:deploy": "cd worker && bunx wrangler deploy"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
